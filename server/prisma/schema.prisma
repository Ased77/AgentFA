generator client {
  provider = "prisma-client-js"
  // Rust-free client: the connection pool is owned by the `pg` driver adapter
  // instead of a query-engine binary. Required for Vercel functions, where the
  // platform-specific engine binary (rhel-openssl-3.0.x) is the usual cause of
  // "Query Engine not found" at runtime.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum PlanKey {
  free
  basic
  pro
}

enum MeterMode {
  tokens
  time
}

enum TxType {
  topup
  purchase
  plan
  refund
}

enum TxStatus {
  pending
  success
  failed
}

model User {
  id String @id @default(cuid())
  /// Login identity: a normalized Iranian mobile (`+989xxxxxxxxx`). Null only on
  /// rows that predate phone login; they claim their number on first SMS login.
  phone     String?  @unique
  role      Role     @default(user)
  createdAt DateTime @default(now())

  wallet       Wallet?
  entitlements Entitlement[]
  sessions     Session[]
  transactions Transaction[]
  usage        UsageEvent[]
  conversations Conversation[]
  previews      PreviewUsage[]
  clientErrors  ClientError[]
}

model Wallet {
  userId                  String    @id
  plan                    PlanKey   @default(free)
  tokenBalance            Int       @default(50000)
  timeBalanceSeconds      Int       @default(3600)
  monthlyTokenLimit       Int       @default(50000)
  monthlyTimeLimitSeconds Int       @default(3600)
  monthlyUsage            Int       @default(0)
  monthlyTimeUsedSeconds  Int       @default(0)
  periodStart             DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id         String   @id @default(cuid())
  userId     String
  agentId    String
  pricePaid  Int
  purchasedAt DateTime @default(now())
  /// Set when a purchase is refunded. The row is kept for the audit trail.
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
}

/// One SMS login challenge.
///
/// The code is stored hashed (never in the clear) and is single-use: `consumedAt`
/// is set the moment it is accepted, so a replayed code resolves to no row and
/// the attempt cap lives on `attempts` instead of an in-memory counter.
model LoginCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  ip         String?

  @@index([phone, createdAt])
}

/// Payment record. `orderId` is ours, `providerToken` is the gateway's handle
/// (authority / checkout session) and `refId` is the gateway reference shown to
/// the payer. Both provider columns are unique, so a replayed callback settles
/// at most once.
model Transaction {
  id            String    @id @default(cuid())
  orderId       String    @unique
  userId        String
  type          TxType
  status        TxStatus  @default(pending)
  tokens        Int       @default(0)
  minutes       Int       @default(0)
  amount        Int       @default(0)
  currency      String    @default("IRT")
  provider      String?
  providerToken String?   @unique
  refId         String?   @unique
  agentId       String?
  /// Plan purchased by a `plan` transaction, and the period it buys.
  plan          PlanKey?
  billingPeriod String?
  paidAt        DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model UsageEvent {
  id            String   @id @default(cuid())
  userId        String
  agentId       String
  tokens        Int
  seconds       Int
  estimated     Boolean  @default(false)
  providerModel String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ProviderConfig {
  id              String    @id @default(cuid())
  label           String    @default("")
  baseUrl         String
  apiKeyCipher    String
  model           String
  meter           MeterMode @default(tokens)
  tomanPer1kTokens Int      @default(2000)
  tomanPerMinute  Int       @default(30000)
  agentScope      String[]  @default(["*"])
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// One conversation between a user and one agent.
///
/// Chats used to live only in the browser tab, so a refresh erased them. Titles
/// are derived from the first user message when the conversation is created;
/// `totalTokens` mirrors the debits so the sidebar can show usage without a join.
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  agentId     String
  title       String   @default("")
  totalTokens Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, agentId, updatedAt])
}

/// A persisted chat turn. `role` is `user` or `assistant` (kept as text so the
/// assistant's own name is never confused with the account Role enum).
model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  tokens         Int      @default(0)
  seconds        Int      @default(0)
  model          String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Free-preview counter: how many trial replies a user has used on an agent they
/// have not bought. Kept server-side so the allowance cannot be reset by
/// clearing browser storage.
model PreviewUsage {
  userId    String
  agentId   String
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, agentId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Public catalog metadata. Prices are server-owned: a purchase re-reads the
/// price from this table and never trusts a client-supplied one.
model Agent {
  id              String   @id
  slug            String   @unique
  icon            String   @default("🤖")
  name            String
  category        String
  division        String
  divisionLabel   String
  price           Int
  description     String
  longDescription String
  features        String[]
  prompts         String[]
  welcome         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  persona     Persona?
  divisionRef Division?  @relation(fields: [division], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@index([division])
}

/// Full, untruncated persona body. Never shipped to the browser for an agent
/// the user does not own.
model Persona {
  agentId   String   @id
  body      String
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Division {
  slug      String @id
  label     String
  labelFa   String @default("")
  icon      String @default("")
  color     String @default("")
  sortOrder Int    @default(0)

  agents Agent[]
}

/// Fixed-window counters for API rate limiting. Replaces the Redis sliding
/// window, which cannot survive a serverless deployment.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}

/// A crash or failed request reported by a browser.
///
/// Without this, a render error in a visitor's browser produced nothing but a
/// console message: the uptime check sees HTTP, not a React tree that threw. A
/// blank page could sit there until someone happened to reload it.
model ClientError {
  id String @id @default(cuid())

  /// Grouping key: what makes two reports the *same* failure, rather than two
  /// rows nobody can triage. Derived on the server, never trusted from input.
  /// Unique, so a repeat report is one atomic upsert rather than a read-modify-write.
  fingerprint String @unique
  /// The failure itself: message for a crash, request path for a bad response.
  kind     String
  message  String
  /// Original message, kept only when redaction actually changed it — otherwise
  /// nobody can tell whether a value was removed or never sent.
  rawMessage String?
  stack      String @default("")
  source     String @default("")
  route      String @default("")
  release    String @default("")
  userAgent  String @default("")
  lang       String @default("")
  viewport   String @default("")
  /// Set when the user was signed in. No phone number, no IP, no session id.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  count        Int      @default(1)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@index([lastSeenAt])
}