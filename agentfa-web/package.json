{
  "name": "agentfa-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vite build",
    "preview": "vite preview",
    "catalog": "node scripts/generate-catalog.mjs",
    "export:server-content": "bun run catalog && node scripts/export-personas.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run check:i18n && bun run typecheck",
    "format": "oxfmt"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "lucide-react": "^1.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
