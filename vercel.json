{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd server && bun install && cd ../agentfa-web && bun install",
  "buildCommand": "cd agentfa-web && bun run export:server-content && cd ../server && bun run build:vercel && cd ../agentfa-web && bun run build",
  "outputDirectory": "agentfa-web/dist",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/marketplace",
      "destination": "/index.html"
    },
    { "source": "/agent/(.*)", "destination": "/index.html" },
    { "source": "/chat/(.*)", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/payment-required", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/verify", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
