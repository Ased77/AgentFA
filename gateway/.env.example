# ==============================================================================
# AI Gateway - environment variables
# Copy to .env and fill in real values.  NEVER commit .env.
#
# NOTE: keep one `KEY=value` per line and avoid trailing inline comments -
# docker compose does not reliably strip them.
# ==============================================================================

# ------------------------------------------------------------------------------
# LiteLLM proxy
# ------------------------------------------------------------------------------
# Master key: ONLY the FastAPI app uses it. Generate with:
#   python -c "import secrets; print('sk-gw-' + secrets.token_urlsafe(48))"
LITELLM_MASTER_KEY=sk-gw-CHANGE_ME_master_key

# Salt used by LiteLLM to encrypt secrets at rest. Generate the same way.
LITELLM_SALT_KEY=CHANGE_ME_salt_key

# Internal Postgres connection for LiteLLM spend logs
LITELLM_DATABASE_URL=postgresql://gateway:gateway@postgres:5432/litellm

# ------------------------------------------------------------------------------
# Provider API keys (TWO per provider, for rotation + load balancing)
# ------------------------------------------------------------------------------
OPENAI_API_KEY_1=sk-CHANGE_ME_openai_key_1
OPENAI_API_KEY_2=sk-CHANGE_ME_openai_key_2
ANTHROPIC_API_KEY_1=sk-ant-CHANGE_ME_anthropic_key_1
ANTHROPIC_API_KEY_2=sk-ant-CHANGE_ME_anthropic_key_2
GEMINI_API_KEY_1=AIzaCHANGE_ME_gemini_key_1
GEMINI_API_KEY_2=AIzaCHANGE_ME_gemini_key_2

# Ollama (local last line of defence). From inside Docker use
# host.docker.internal; on Linux add
# extra_hosts: ["host.docker.internal:host-gateway"] to the litellm service.
OLLAMA_API_BASE=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# Shared infrastructure
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Postgres superuser credentials (used by the postgres container + init script)
POSTGRES_USER=gateway
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# FastAPI app database (SQLAlchemy async DSN - note the +asyncpg driver)
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway

# ------------------------------------------------------------------------------
# FastAPI application
# ------------------------------------------------------------------------------
API_PORT=8000

# JWT auth for customers
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Billing: customer charge = real_cost * MARKUP (must be >= 1.0)
MARKUP=2.5

# Safety limits
# RATE_LIMIT_PER_MIN: requests per minute per user
# DAILY_MESSAGE_CAP: messages per day per user
RATE_LIMIT_PER_MIN=60
DAILY_MESSAGE_CAP=200

# Credit granted on signup (USD)
SIGNUP_BONUS_CREDIT=5.0

# Logging verbosity for the API container: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# Optional test-only switch: allow the API Settings to load without
# LITELLM_MASTER_KEY / JWT_SECRET (used by pytest). Never set in production.
# GATEWAY_ALLOW_MISSING_SECRETS=1
